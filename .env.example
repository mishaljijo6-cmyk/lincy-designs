# Match the cap to your configured maximum convenience fee (example: 300 = 3%).
RAZORPAY_CUSTOMER_PAYS_FEE=false
RAZORPAY_CUSTOMER_FEE_MAX_BPS=300
CRON_SECRET=GENERATE_A_DIFFERENT_PRIVATE_SECRET_FOR_SCHEDULED_RECONCILIATION
PUBLIC_SITE_URL=https://lincydesigns.vercel.app
SUPABASE_URL=https://fszzfniakuwiuzupfcue.supabase.co
# Preferred: Supabase Settings > API Keys > Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=ADD_PRIVATELY_FROM_SUPABASE
