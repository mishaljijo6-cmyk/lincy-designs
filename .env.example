# Add these privately to the LINCY DESIGNS Vercel project Environment Variables.
RAZORPAY_KEY_ID=rzp_live_ADD_LIVE_KEY_ID_PRIVATELY
RAZORPAY_KEY_SECRET=ADD_LIVE_KEY_SECRET_PRIVATELY
RAZORPAY_WEBHOOK_SECRET=GENERATE_A_PRIVATE_WEBHOOK_SECRET
# Store checkout adds a disclosed 2% online-payment fee directly to the amount
# sent to Razorpay. Keep Razorpay's separate dashboard fee pass-through off to
# avoid charging customers twice. This only bounds accepted gateway amounts.
CRON_SECRET=GENERATE_A_DIFFERENT_PRIVATE_SECRET_FOR_SCHEDULED_RECONCILIATION
PUBLIC_SITE_URL=https://lincydesigns.vercel.app
SUPABASE_URL=https://fszzfniakuwiuzupfcue.supabase.co
# Preferred: Supabase Settings > API Keys > Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=ADD_PRIVATELY_FROM_SUPABASE
# Legacy alternative: service_role JWT (eyJ...)
# SUPABASE_SERVICE_ROLE_KEY=ADD_PRIVATELY_FROM_SUPABASE
